# REQUIRED — Apps Script web-app URL for the EXHIBITOR registration sheet (Form 2).
# Deploy `apps-script-template.js` against a new Google Sheet and paste the
# resulting Web app URL here. See CLAUDE.md → Backend setup.
VITE_FORM_ENDPOINT=

# REQUIRED — CII payment-page URL the form redirects to after a successful
# submission. Set per event (e.g. for LevelUp Northeast 2026, paste the CII
# registration link with the correct EventId). If unset, submissions still
# save but the post-submit redirect is skipped (logged as a console error).
VITE_CII_PAYMENT_URL=
