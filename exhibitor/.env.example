# Apps Script web-app URL for the EXHIBITOR registration sheet (Form 2).
# Deploy `apps-script-template.js` against a new Google Sheet and paste the
# resulting Web app URL here. See CLAUDE.md → Backend setup.
VITE_FORM_ENDPOINT=

# CII payment-page URL the form redirects to after a successful submission.
# If unset, falls back to LevelUp Northeast 2026's registration link.
# Override per event in production (e.g. for a future LevelUp edition).
VITE_CII_PAYMENT_URL=
